# Copy this file to .env and fill in real values.
# Never commit the real .env file (it is already in .gitignore).

# Google Gemini API key - used only to classify/understand customer messages.
GEMINI_API_KEY=

# Instagram / Meta webhook integration
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
META_API_VERSION=v21.0

# Business contact details, used in handoff / callback messages
BUSINESS_OWNER_EMAIL=
BUSINESS_PHONE_NUMBER=

# Google Sheets access (pricing, packages, business info, leads)
# Place the real key file at credentials/google-service-account.json
# (that path is already in .gitignore - never commit the real file)
